+void AugSystemSolver<OcpType>::capture_factor_cache(
+    const ProblemInfo<OcpType> &info, const Jacobian<OcpType> &jacobian,
+    const Hessian<OcpType> &hessian, const VecRealView &D_x,
+    const VecRealView *D_eq, const VecRealView &D_s)
+{
+    factor_cache_valid_ = false;
+    cached_forward_hessians_.clear();
+    cached_terminal_hessian_.clear();
+    cached_dynamics_.clear();
+    if (info.dims.K <= 1)
+        return;
+
+    const Index horizon = info.dims.K - 1;
+    const Index nx = info.dims.number_of_tangent_states[0];
+    const Index nu = info.dims.number_of_tangent_controls[0];
+    const Index stage_dim = nx + nu;
+    if (info.dims.number_of_tangent_controls[horizon] != 0)
+        return;
+    for (Index k = 0; k < info.dims.K; ++k)
+    {
+        if (info.dims.number_of_tangent_states[k] != nx)
+            return;
+        if (k < horizon && info.dims.number_of_tangent_controls[k] != nu)
+            return;
+    }
+
+    cached_forward_hessians_.resize(
+        static_cast<std::size_t>(horizon) * stage_dim * stage_dim);
+    cached_terminal_hessian_.resize(static_cast<std::size_t>(nx) * nx);
+    cached_dynamics_.resize(
+        static_cast<std::size_t>(horizon) * nx * stage_dim);
+
+    const auto reduced_hessian_entry =
+        [&](Index k, Index row, Index column) -> Scalar
+    {
+        const Index lower_row = row > column ? row : column;
+        const Index lower_column = row < column ? row : column;
+        Scalar value = hessian.RSQrqt[k](lower_row, lower_column);
+        if (row == column)
+            value += D_x(info.offsets_tangent_u[k] + row);
+
+        const Index ng_ineq = info.dims.number_of_ineq_constraints[k];
+        const Index slack_offset = info.offsets_slack[k];
+        for (Index i = 0; i < ng_ineq; ++i)
+            value += jacobian.Gg_ineqt[k](row, i) *
+                     jacobian.Gg_ineqt[k](column, i) /
+                     D_s(slack_offset + i);
+
+        if (D_eq != nullptr)
+        {
+            const Index ng_eq = info.dims.number_of_eq_constraints[k];
+            const Index eq_offset = info.offsets_eq[k];
+            for (Index i = 0; i < ng_eq; ++i)
+                value += jacobian.Gg_eqt[k](row, i) *
+                         jacobian.Gg_eqt[k](column, i) /
+                         (*D_eq)(eq_offset + i);
+        }
+        return value;
+    };
+
+    for (Index k = 0; k < horizon; ++k)
+    {
+        for (Index external_row = 0; external_row < stage_dim; ++external_row)
+        {
+            const Index internal_row =
+                external_row < nx ? nu + external_row : external_row - nx;
+            for (Index external_column = 0; external_column <= external_row;
+                 ++external_column)
+            {
+                const Index internal_column = external_column < nx
+                                                  ? nu + external_column
+                                                  : external_column - nx;
+                const Scalar value =
+                    reduced_hessian_entry(k, internal_row, internal_column);
+                const std::size_t row_offset =
+                    (static_cast<std::size_t>(k) * stage_dim + external_row) *
+                    stage_dim;
+                const std::size_t column_offset =
+                    (static_cast<std::size_t>(k) * stage_dim + external_column) *
+                    stage_dim;
+                cached_forward_hessians_[row_offset + external_column] = value;
+                cached_forward_hessians_[column_offset + external_row] = value;
+            }
+        }
+
+        for (Index row = 0; row < nx; ++row)
+        {
+            const std::size_t row_offset =
+                (static_cast<std::size_t>(k) * nx + row) * stage_dim;
+            for (Index column = 0; column < nx; ++column)
+                cached_dynamics_[row_offset + column] =
+                    -jacobian.BAbt[k](nu + column, row);
+            for (Index column = 0; column < nu; ++column)
+                cached_dynamics_[row_offset + nx + column] =
+                    -jacobian.BAbt[k](column, row);
+        }
+    }
+
+    for (Index row = 0; row < nx; ++row)
+        for (Index column = 0; column <= row; ++column)
+        {
+            const Scalar value = reduced_hessian_entry(horizon, row, column);
+            cached_terminal_hessian_[static_cast<std::size_t>(row) * nx +
+                                     column] = value;
+            cached_terminal_hessian_[static_cast<std::size_t>(column) * nx +
+                                     row] = value;
+        }
+    factor_cache_valid_ = true;
+}
