+bool AugSystemSolver<OcpType>::export_rhs_factors(
+    const ProblemInfo<OcpType> &info, Scalar *value_hessians,
+    Scalar *control_cholesky, Scalar *cross_factors) const
+{
+    if (value_hessians == nullptr || control_cholesky == nullptr ||
+        cross_factors == nullptr || info.dims.K <= 0)
+        return false;
+
+    const Index nx = info.dims.number_of_tangent_states[0];
+    const Index nu = info.dims.number_of_tangent_controls[0];
+    for (Index k = 0; k < info.dims.K; ++k)
+    {
+        if (info.dims.number_of_tangent_states[k] != nx)
+            return false;
+        if (k + 1 < info.dims.K &&
+            (info.dims.number_of_tangent_controls[k] != nu || rho[k] != 0))
+            return false;
+        for (Index i = 0; i < nx; ++i)
+            for (Index j = 0; j < nx; ++j)
+                value_hessians[(k * nx + i) * nx + j] = Ppt[k](i, j);
+
+        if (k + 1 == info.dims.K)
+            continue;
+        for (Index i = 0; i < nu; ++i)
+            for (Index j = 0; j < nu; ++j)
+                control_cholesky[(k * nu + i) * nu + j] = Llt[k](i, j);
+        for (Index i = 0; i < nx; ++i)
+            for (Index j = 0; j < nu; ++j)
+                cross_factors[(k * nx + i) * nu + j] = Llt[k](nu + i, j);
+    }
+    return true;
+}
+
+bool AugSystemSolver<OcpType>::export_factor_cache(
+    const ProblemInfo<OcpType> &info, Scalar *forward_hessians,
+    Scalar *terminal_hessian, Scalar *dynamics, Scalar *value_hessians,
+    Scalar *control_cholesky, Scalar *cross_factors) const
+{
+    if (!factor_cache_valid_ || forward_hessians == nullptr ||
+        terminal_hessian == nullptr || dynamics == nullptr)
+        return false;
+    if (!export_rhs_factors(info, value_hessians, control_cholesky,
+                            cross_factors))
+        return false;
+    for (std::size_t i = 0; i < cached_forward_hessians_.size(); ++i)
+        forward_hessians[i] = cached_forward_hessians_[i];
+    for (std::size_t i = 0; i < cached_terminal_hessian_.size(); ++i)
+        terminal_hessian[i] = cached_terminal_hessian_[i];
+    for (std::size_t i = 0; i < cached_dynamics_.size(); ++i)
+        dynamics[i] = cached_dynamics_[i];
+    return true;
+}
