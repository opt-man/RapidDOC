+
+bool PdSolverOrig<OcpType>::solve_cached_reduced_rhs(
+    const Scalar *rhs_f, const Scalar *rhs_g, Scalar *x, Scalar *mult)
+{
+    if (rhs_f == nullptr || rhs_g == nullptr || x == nullptr ||
+        mult == nullptr || !rhs_cache_valid_ || cached_info_ == nullptr ||
+        cached_jacobian_ == nullptr || cached_hessian_ == nullptr)
+        return false;
+
+    // AugSystemSolver uses residual vectors f,g and solves K z = -[f;g].
+    // Negating here gives this public entry point the conventional K z = rhs
+    // semantics used by the differentiable backward solver.
+    for (Index i = 0; i < cached_rhs_f_.m(); ++i)
+        cached_rhs_f_(i) = -rhs_f[i];
+    for (Index i = 0; i < cached_rhs_g_.m(); ++i)
+        cached_rhs_g_(i) = -rhs_g[i];
+
+    const LinsolReturnFlag status = cached_has_D_eq_
+        ? aug_system_solver_->solve_rhs(
+              *cached_info_, *cached_jacobian_, *cached_hessian_, cached_D_eq_,
+              D_ii_, cached_rhs_f_, cached_rhs_g_, x_aug_, mult_aug_)
+        : aug_system_solver_->solve_rhs(
+              *cached_info_, *cached_jacobian_, *cached_hessian_, D_ii_,
+              cached_rhs_f_, cached_rhs_g_, x_aug_, mult_aug_);
+    if (status != LinsolReturnFlag::SUCCESS)
+        return false;
+
+    for (Index i = 0; i < x_aug_.m(); ++i)
+        x[i] = x_aug_(i);
+    for (Index i = 0; i < mult_aug_.m(); ++i)
+        mult[i] = mult_aug_(i);
+    return x_aug_.is_finite() && mult_aug_.is_finite();
+}
+
+bool PdSolverOrig<OcpType>::solve_cached_reduced_rhs_batch(
+    const Scalar *rhs_f, const Scalar *rhs_g, int nrhs, Scalar *x,
+    Scalar *mult)
+{
+    if (rhs_f == nullptr || rhs_g == nullptr || x == nullptr ||
+        mult == nullptr || nrhs <= 0)
+        return false;
+
+    const Index nf = cached_rhs_f_.m();
+    const Index ng = cached_rhs_g_.m();
+    for (int column = 0; column < nrhs; ++column)
+        if (!solve_cached_reduced_rhs(
+                rhs_f + static_cast<std::size_t>(column) * nf,
+                rhs_g + static_cast<std::size_t>(column) * ng,
+                x + static_cast<std::size_t>(column) * nf,
+                mult + static_cast<std::size_t>(column) * ng))
+            return false;
+    return true;
+}
+
+bool PdSolverOrig<OcpType>::export_rhs_factors(
+    const ProblemInfo<OcpType> &info, Scalar *value_hessians,
+    Scalar *control_cholesky, Scalar *cross_factors) const
+{
+    return aug_system_solver_->export_rhs_factors(
+        info, value_hessians, control_cholesky, cross_factors);
+}
+
+bool PdSolverOrig<OcpType>::export_factor_cache(
+    const ProblemInfo<OcpType> &info, Scalar *forward_hessians,
+    Scalar *terminal_hessian, Scalar *dynamics, Scalar *value_hessians,
+    Scalar *control_cholesky, Scalar *cross_factors) const
+{
+    return aug_system_solver_->export_factor_cache(
+        info, forward_hessians, terminal_hessian, dynamics, value_hessians,
+        control_cholesky, cross_factors);
+}
