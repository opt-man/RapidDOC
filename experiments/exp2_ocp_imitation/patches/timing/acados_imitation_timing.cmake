# The figure-eight source may already contain broad xcond-interface timers.
# Remove them in this PRIVATE copy: cast/zero/copy/pack are not solve kernels.
set(_common "${_source}/acados/ocp_nlp/ocp_nlp_common.c")
file(READ "${_common}" _code)
string(REGEX REPLACE "acados_timer frs_[A-Za-z_0-9]+;" "" _code "${_code}")
string(REGEX REPLACE "if\\(frs_acados_enabled\\) acados_tic\\(&frs_[A-Za-z_0-9]+\\);" "" _code "${_code}")
string(REGEX REPLACE "frs_acados_record\\(&frs_[A-Za-z_0-9]+\\);" "" _code "${_code}")
if(_code MATCHES "frs_acados_enabled|frs_acados_record|acados_timer frs_")
    message(FATAL_ERROR "An outer timer survived removal")
endif()
file(WRITE "${_common}" "${_code}")
configure_file("${CMAKE_CURRENT_LIST_DIR}/acados_solve_timer_forward.h" "${_source}/acados/ocp_nlp/acados_solve_timer.h" COPYONLY)
set(_hpipm "${_source}/external/hpipm")
configure_file("${CMAKE_CURRENT_LIST_DIR}/acados_hpipm_timer.h" "${_hpipm}/include/acados_hpipm_timer.h" COPYONLY)
configure_file("${CMAKE_CURRENT_LIST_DIR}/acados_hpipm_timer.c" "${_hpipm}/acados_hpipm_timer.c" COPYONLY)

# Override call macros only in double-precision translation units. The actual
# factor/solve/residual routines retain their native algorithm and internal
# work; standalone wrapper bookkeeping and sensitivity backup copies do not.
function(frs_wrap variable kind dimension)
    set(_text "${${variable}}")
    foreach(_name IN LISTS ARGN)
        string(REGEX MATCH "#define ${_name} ([A-Za-z_0-9]+)" _match "${_text}")
        if(NOT _match)
            message(FATAL_ERROR "Missing HPIPM call macro ${_name}")
        endif()
        set(_callee "${CMAKE_MATCH_1}")
        if(dimension STREQUAL "two")
            set(_replacement "#define ${_name}(m,n,...) FRS_HPIPM_IF((m)>0 && (n)>0, ${kind}, ${_callee}(m,n,__VA_ARGS__))")
        elseif(dimension STREQUAL "one")
            set(_replacement "#define ${_name}(m,...) FRS_HPIPM_IF((m)>0, ${kind}, ${_callee}(m,__VA_ARGS__))")
        elseif(dimension STREQUAL "value")
            set(_replacement "#define ${_name}(...) FRS_HPIPM_VALUE(${kind}, ${_callee}(__VA_ARGS__))")
        else()
            set(_replacement "#define ${_name}(...) FRS_HPIPM_VOID(${kind}, ${_callee}(__VA_ARGS__))")
        endif()
        string(REPLACE "${_match}" "${_replacement}" _text "${_text}")
    endforeach()
    set(${variable} "${_text}" PARENT_SCOPE)
endfunction()

foreach(_unit ocp_qp/d_ocp_qp_ipm.c ocp_qp/d_ocp_qp_red.c cond/d_cond_aux.c cond/d_part_cond.c)
    file(READ "${_hpipm}/${_unit}" _unit_code)
    if(_unit_code MATCHES "acados_hpipm_timer.h")
        continue()
    endif()
    set(_unit_code "#include \"acados_hpipm_timer.h\"\n${_unit_code}")
    if(_unit MATCHES "d_ocp_qp_ipm")
        frs_wrap(_unit_code FRS_FACTOR none OCP_QP_FACT_KKT_STEP OCP_QP_FACT_SOLVE_KKT_STEP OCP_QP_FACT_LQ_SOLVE_KKT_STEP OCP_QP_FACT_SOLVE_KKT_UNCONSTR)
        frs_wrap(_unit_code FRS_SOLVE none OCP_QP_SOLVE_KKT_STEP)
        frs_wrap(_unit_code FRS_RESIDUAL none OCP_QP_RES_COMPUTE OCP_QP_RES_COMPUTE_INF_NORM OCP_QP_RES_COMPUTE_LIN)
        frs_wrap(_unit_code FRS_VECTOR one AXPY VECCPSC VECMUL VECNRM_INF VECSC TRSV_LTN TRMV_LNN TRMV_LTN)
        frs_wrap(_unit_code FRS_VECTOR two GEMV_T SYRK_LN TRSM_RLNN)
        frs_wrap(_unit_code FRS_VECTOR value VECMULDOT)
        frs_wrap(_unit_code FRS_IPM_CONTROL none COMPUTE_ALPHA_QP COMPUTE_CENTERING_CORRECTION_QP COMPUTE_CENTERING_QP COMPUTE_MU_AFF_QP COMPUTE_TAU_MIN_QP)
        # Use a double-only private template so single precision stays untouched.
        string(REPLACE "\"x_ocp_qp_ipm.c\"" "\"x_ocp_qp_ipm_frs.c\"" _unit_code "${_unit_code}")
    elseif(_unit MATCHES "d_ocp_qp_red")
        frs_wrap(_unit_code FRS_REDUCTION one AXPY SYMV_L VECAD_SP VECSC)
        frs_wrap(_unit_code FRS_REDUCTION two GEMV_N GEMV_T)
    elseif(_unit MATCHES "d_cond_aux")
        frs_wrap(_unit_code FRS_CONDENSING one AXPY SYMV_L VECAD_SP POTRF_L ROWAD GEMV_D)
        frs_wrap(_unit_code FRS_CONDENSING two GEAD GEMM_ND GEMM_NN GEMM_NT GEMV_N GEMV_T POTRF_L_MN SYRK_LN_MN TRMM_RLNN)
    else()
        frs_wrap(_unit_code FRS_CONDENSING one VECSC)
    endif()
    file(WRITE "${_hpipm}/${_unit}" "${_unit_code}")
endforeach()

file(READ "${_hpipm}/ocp_qp/x_ocp_qp_ipm.c" _ipm)
replace_once(_ipm "void OCP_QP_IPM_SOLVE(struct OCP_QP *qp, struct OCP_QP_SOL *qp_sol, struct OCP_QP_IPM_ARG *arg, struct OCP_QP_IPM_WS *ws)\n\t{"
    "void OCP_QP_IPM_SOLVE(struct OCP_QP *qp, struct OCP_QP_SOL *qp_sol, struct OCP_QP_IPM_ARG *arg, struct OCP_QP_IPM_WS *ws)\n\t{\n\tfrs_hpipm_record_qp_call_v4();")
string(FIND "${_ipm}" "// forward solution sensitivities" _forw_at)
string(FIND "${_ipm}" "// adjoint solution sensitivities" _adj_at)
if(_forw_at LESS 0 OR _adj_at LESS _forw_at)
    message(FATAL_ERROR "Missing HPIPM sensitivity section anchors")
endif()
string(SUBSTRING "${_ipm}" 0 ${_forw_at} _prefix)
math(EXPR _length "${_adj_at}-${_forw_at}")
string(SUBSTRING "${_ipm}" ${_forw_at} ${_length} _forw)
string(SUBSTRING "${_ipm}" ${_adj_at} -1 _adj)
replace_once(_forw "OCP_QP_SOLVE_KKT_STEP(&tmp_qp, sens, arg, ws);" "FRS_HPIPM_VOID(FRS_FORWARD, d_ocp_qp_solve_kkt_step(&tmp_qp, sens, arg, ws));")
replace_once(_adj "OCP_QP_SOLVE_KKT_STEP(&tmp_qp, sens, arg, ws);" "FRS_HPIPM_VOID(FRS_ADJOINT, d_ocp_qp_solve_kkt_step(&tmp_qp, sens, arg, ws));")
replace_once(_adj "\tfor(ii=0; ii<cws->nc; ii++)\n\t\t{\n\t\ttmp_m[ii] = seed_m[ii];\n\t\tseed_m[ii] *= cws->t[ii];\n\t\t}"
    "\tfor(ii=0; ii<cws->nc; ii++) tmp_m[ii] = seed_m[ii];\n\tif(cws->nc>0) { FRS_HPIPM_VOID(FRS_VECTOR, for(ii=0; ii<cws->nc; ii++) { seed_m[ii] *= cws->t[ii]; }); }")
replace_once(_adj "\tfor(ii=0; ii<cws->nc; ii++)\n\t\t{\n\t\tt[ii] *= cws->t_inv[ii];\n\t\t}"
    "\tif(cws->nc>0) { FRS_HPIPM_VOID(FRS_VECTOR, for(ii=0; ii<cws->nc; ii++) { t[ii] *= cws->t_inv[ii]; }); }")
file(WRITE "${_hpipm}/ocp_qp/x_ocp_qp_ipm_frs.c" "${_prefix}${_forw}${_adj}")

# UPDATE_VAR_QP interleaves backup copies and arithmetic. In the private
# double/GENERIC implementation, preserve the backups before timing only the
# actual damped primal/dual update. No backup/cache copy enters the timer.
file(READ "${_hpipm}/ipm_core/x_core_qp_ipm_aux.c" _core)
string(FIND "${_core}" "void UPDATE_VAR_QP(" _update_at)
string(FIND "${_core}" "void BACKUP_VAR_QP(" _backup_at)
if(_update_at LESS 0 OR _backup_at LESS _update_at)
    message(FATAL_ERROR "Missing HPIPM core update anchors")
endif()
string(SUBSTRING "${_core}" 0 ${_update_at} _core_before)
math(EXPR _update_len "${_backup_at}-${_update_at}")
string(SUBSTRING "${_core}" ${_update_at} ${_update_len} _update)
string(SUBSTRING "${_core}" ${_backup_at} -1 _core_after)
foreach(_var v pi lam t)
    string(REGEX REPLACE "[\t ]+${_var}_bkp\\[ii\\] = ${_var}\\[ii\\];\n" "" _update "${_update}")
endforeach()
replace_once(_update "#if 0\n\tif(alpha<1.0)"
    "\tint frs_i;\n\tfor(frs_i=0; frs_i<nv; ++frs_i) v_bkp[frs_i]=v[frs_i];\n\tfor(frs_i=0; frs_i<ne; ++frs_i) pi_bkp[frs_i]=pi[frs_i];\n\tfor(frs_i=0; frs_i<nc; ++frs_i) { lam_bkp[frs_i]=lam[frs_i]; t_bkp[frs_i]=t[frs_i]; }\n\tfrs_hpipm_kernel_begin_v3(FRS_IPM_CONTROL);\n#if 0\n\tif(alpha<1.0)")
replace_once(_update "\treturn;" "\tfrs_hpipm_kernel_end_v3();\n\treturn;")
file(WRITE "${_hpipm}/ipm_core/x_core_qp_ipm_aux_frs.c" "${_core_before}${_update}${_core_after}")
file(READ "${_hpipm}/ipm_core/d_core_qp_ipm_aux.c" _core_unit)
if(NOT _core_unit MATCHES "x_core_qp_ipm_aux_frs.c")
    string(REPLACE "\"x_core_qp_ipm_aux.c\"" "\"x_core_qp_ipm_aux_frs.c\"" _core_unit "${_core_unit}")
    file(WRITE "${_hpipm}/ipm_core/d_core_qp_ipm_aux.c" "#include \"acados_hpipm_timer.h\"\n${_core_unit}")
endif()

file(READ "${_hpipm}/CMakeLists.txt" _build)
if(NOT _build MATCHES "acados_hpipm_timer.c")
    replace_once(_build "add_library(hpipm \${HPIPM_SRC})" "add_library(hpipm \${HPIPM_SRC})\ntarget_sources(hpipm PRIVATE acados_hpipm_timer.c)\nset_target_properties(hpipm PROPERTIES RUNTIME_OUTPUT_NAME frs_imitation_hpipm ARCHIVE_OUTPUT_NAME hpipm)")
    file(WRITE "${_hpipm}/CMakeLists.txt" "${_build}")
endif()
file(READ "${_source}/external/CMakeLists.txt" _external)
if(NOT _external MATCHES "frs_imitation_blasfeo")
    string(APPEND _external "\nset_target_properties(blasfeo PROPERTIES RUNTIME_OUTPUT_NAME frs_imitation_blasfeo ARCHIVE_OUTPUT_NAME blasfeo)\n")
    file(WRITE "${_source}/external/CMakeLists.txt" "${_external}")
endif()

# Upstream 0.5.1 invokes t_renderer through an unquoted shell command. The
# private installation lives in a path containing spaces; use an argv list.
set(_utils "${_source}/interfaces/acados_template/acados_template/utils.py")
file(READ "${_utils}" _python)
set(_old "        status = os.system(os_cmd)")
set(_new "        import subprocess\n        status = subprocess.call([tera_path, template_glob, in_file, json_path, out_file])")
if(_python MATCHES "status = os.system\\(os_cmd\\)")
    string(REPLACE "${_old}" "${_new}" _python "${_python}")
    file(WRITE "${_utils}" "${_python}")
endif()

# Quote generated CMake path values; no solver or model expressions change.
set(_template "${_source}/interfaces/acados_template/acados_template/c_templates_tera/CMakeLists.in.txt")
file(READ "${_template}" _cmake)
foreach(_name CMAKE_RUNTIME_OUTPUT_DIRECTORY_RELEASE CMAKE_ARCHIVE_OUTPUT_DIRECTORY_RELEASE CMAKE_LIBRARY_OUTPUT_DIRECTORY_RELEASE ACADOS_INCLUDE_PATH ACADOS_LIB_PATH)
    string(REGEX REPLACE "set\\(${_name} (\\{\\{[^\n]+\\}\\})" "set(${_name} \"\\1\"" _cmake "${_cmake}")
endforeach()
file(WRITE "${_template}" "${_cmake}")
message(STATUS "Private acados: strict HPIPM kernels, reduction and condensing arithmetic; outer timers removed")
