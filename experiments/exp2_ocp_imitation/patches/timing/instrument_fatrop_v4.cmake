cmake_minimum_required(VERSION 3.21)
get_filename_component(_project "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
get_filename_component(_source "${FATROP_SOURCE_DIR}" ABSOLUTE)
get_filename_component(_private "${_project}/.fatrop-v4/source" ABSOLUTE)
if(NOT _source STREQUAL _private)
    message(FATAL_ERROR "Only the private .fatrop-v4/source may be instrumented")
endif()
function(frs_replace variable old new)
    set(_code "${${variable}}")
    string(FIND "${_code}" "${old}" _at)
    if(_at LESS 0)
        message(FATAL_ERROR "Unsupported FATROP v4 source anchor: ${old}")
    endif()
    string(REPLACE "${old}" "${new}" _code "${_code}")
    set(${variable} "${_code}" PARENT_SCOPE)
endfunction()

# Whitelist actual arithmetic calls, not whole solver methods. All independent
# row/column/vector copies, packing, allocations, structure bookkeeping,
# diagonal KKT assembly and capture_factor_cache remain outside these scopes.
function(frs_calls variable kind dimensions residual_only)
    set(_code "${${variable}}")
    foreach(_name IN LISTS ARGN)
        set(_done "")
        string(REGEX MATCHALL "\n[ \t]*${_name}\\([^;]*\\)" _calls "${_code}")
        list(REMOVE_DUPLICATES _calls)
        foreach(_call IN LISTS _calls)
            string(STRIP "${_call}" _call)
            if(_call IN_LIST _done)
                continue()
            endif()
            list(APPEND _done "${_call}")
            string(REGEX MATCH "^[^(]+\\(([^,]+),([^,]+)," _dims "${_call}")
            set(_m "${CMAKE_MATCH_1}")
            set(_n "${CMAKE_MATCH_2}")
            set(_condition "(${_m}) > 0")
            if(dimensions STREQUAL "two")
                string(APPEND _condition " && (${_n}) > 0")
            elseif(dimensions STREQUAL "scaled")
                string(APPEND _condition " && (${_n}) != 1.0")
            endif()
            if(residual_only)
                string(APPEND _condition " && frs_fatrop_v4::in_residual()")
            endif()
            string(REPLACE "${_call};" "FRS_FATROP_KERNEL(${kind}, ${_condition}, ${_call});" _code "${_code}")
        endforeach()
    endforeach()
    set(${variable} "${_code}" PARENT_SCOPE)
endfunction()

foreach(_name fatrop_kernel_timer_v4.hpp fatrop_kernel_timer_v4.cpp)
    configure_file("${CMAKE_CURRENT_LIST_DIR}/${_name}" "${_source}/src/${_name}" COPYONLY)
endforeach()
file(READ "${_source}/src/CMakeLists.txt" _cmake)
if(NOT _cmake MATCHES "fatrop_kernel_timer_v4.cpp")
    frs_replace(_cmake "add_library(fatrop SHARED \${FATROP_SOURCES})"
        "add_library(fatrop SHARED \${FATROP_SOURCES})\ntarget_sources(fatrop PRIVATE fatrop_kernel_timer_v4.cpp)\ntarget_include_directories(fatrop PRIVATE \"\${CMAKE_CURRENT_SOURCE_DIR}\")")
    file(WRITE "${_source}/src/CMakeLists.txt" "${_cmake}")
endif()

file(READ "${_source}/src/ocp/aug_system_solver.cpp" _aug)
if(NOT _aug MATCHES "fatrop_kernel_timer_v4.hpp")
    frs_calls(_aug Factor two FALSE potrf_l_mn lu_fact_transposed)
    frs_calls(_aug Backsolve one FALSE trsv_ltn trsv_lnn trsv_utu)
    frs_calls(_aug Riccati two FALSE gemm_nt syrk_ln_mn trsm_rlnn trsm_rltn gemv_n gemv_t gead gead_transposed)
    frs_calls(_aug Riccati one FALSE axpy colsc)
    frs_calls(_aug Backsolve scaled FALSE rowex veccpsc)
    # Vector divisions reconstruct eliminated equality/inequality multipliers.
    string(REGEX MATCHALL "eq_mult\\.block\\([^;]*=[^;]*/[^;]*" _divisions "${_aug}")
    list(REMOVE_DUPLICATES _divisions)
    foreach(_division IN LISTS _divisions)
        string(REPLACE "${_division};" "FRS_FATROP_KERNEL(Reduction, true, ${_division});" _aug "${_aug}")
    endforeach()
    # Scalar division plus column scaling are one numeric elimination loop.
    string(REPLACE ";" "@FRS_SEMICOLON@" _escaped "${_aug}")
    string(REGEX MATCHALL "for \\(Index i = 0@FRS_SEMICOLON@ i < [^@]+@FRS_SEMICOLON@ i\\+\\+\\)[ \t\n]*\\{[^{}]*Scalar scaling_factor[^{}]*\\}" _loops "${_escaped}")
    list(REMOVE_DUPLICATES _loops)
    foreach(_loop IN LISTS _loops)
        string(REPLACE "@FRS_SEMICOLON@" ";" _loop "${_loop}")
        string(REGEX MATCH "i < ([^;]+);" _bound "${_loop}")
        set(_limit "${CMAKE_MATCH_1}")
        string(REPLACE "${_loop}" "{ frs_fatrop_v4::Kernel elimination(frs_fatrop_v4::Reduction, (${_limit}) > 0); ${_loop} }" _aug "${_aug}")
    endforeach()
    file(WRITE "${_source}/src/ocp/aug_system_solver.cpp" "#include \"fatrop_kernel_timer_v4.hpp\"\n${_aug}")
endif()

# This custom triangular solve has an independent tail copy before its
# arithmetic loop. Do not wrap the outer trsv_unu call.
file(READ "${_source}/src/linear_algebra/lu_factorization.cpp" _lu)
if(NOT _lu MATCHES "fatrop_kernel_timer_v4.hpp")
    frs_replace(_lu "        for (Index i = m - 1; i >= 0; i--)"
        "        frs_fatrop_v4::Kernel triangular(frs_fatrop_v4::Backsolve, m > 0);\n        for (Index i = m - 1; i >= 0; i--)")
    file(WRITE "${_source}/src/linear_algebra/lu_factorization.cpp" "#include \"fatrop_kernel_timer_v4.hpp\"\n${_lu}")
endif()

file(READ "${_source}/src/ocp/pd_solver_orig.cpp" _pd)
if(NOT _pd MATCHES "fatrop_kernel_timer_v4.hpp")
    frs_replace(_pd "    sigma_inverse_ =" "    { frs_fatrop_v4::Kernel reduction(frs_fatrop_v4::Reduction, ls.info_.number_of_slack_variables > 0);\n    sigma_inverse_ =")
    frs_replace(_pd "    g_ii_ = gi + sigma_inverse_ * ss_;" "    g_ii_ = gi + sigma_inverse_ * ss_;\n    }")
    frs_replace(_pd "    x.block(ls.info_.number_of_slack_variables, ls.info_.pd_orig_offset_slack) ="
        "    frs_fatrop_v4::Kernel dereduction(frs_fatrop_v4::Reduction, ls.info_.number_of_slack_variables > 0);\n    x.block(ls.info_.number_of_slack_variables, ls.info_.pd_orig_offset_slack) =")
    file(WRITE "${_source}/src/ocp/pd_solver_orig.cpp" "#include \"fatrop_kernel_timer_v4.hpp\"\n${_pd}")
endif()

file(READ "${_source}/src/ocp/pd_solver_resto.cpp" _pd)
if(NOT _pd MATCHES "fatrop_kernel_timer_v4.hpp")
    frs_replace(_pd "    f_pp_ = if_else" "    frs_fatrop_v4::Kernel reduction(frs_fatrop_v4::Reduction);\n    f_pp_ = if_else")
    frs_replace(_pd "    x_p = if_else" "    { frs_fatrop_v4::Kernel dereduction(frs_fatrop_v4::Reduction);\n    x_p = if_else")
    frs_replace(_pd "VecRealScalar(x_n.m(), 0.));" "VecRealScalar(x_n.m(), 0.));\n    }")
    frs_replace(_pd "    x_zp = if_else" "    frs_fatrop_v4::Kernel dual_dereduction(frs_fatrop_v4::Reduction);\n    x_zp = if_else")
    file(WRITE "${_source}/src/ocp/pd_solver_resto.cpp" "#include \"fatrop_kernel_timer_v4.hpp\"\n${_pd}")
endif()

# Linear residual matrix-vector products only; the same Jacobian application
# outside a linear residual (e.g. an NLP convergence check) is not measured.
foreach(_unit pd_system_orig pd_system_resto)
    file(READ "${_source}/src/ocp/${_unit}.cpp" _res)
    if(_res MATCHES "fatrop_kernel_timer_v4.hpp")
        continue()
    endif()
    frs_replace(_res "    out = alpha * y;" "    frs_fatrop_v4::ResidualContext residual_context;\n    FRS_FATROP_KERNEL(Residual, alpha != 0.0 && alpha != 1.0, out = alpha * y);")
    string(REGEX MATCHALL "\n[ \t]*out_[A-Za-z_]+[^=;]*=[^;]*" _expressions "${_res}")
    list(REMOVE_DUPLICATES _expressions)
    foreach(_expression IN LISTS _expressions)
        string(STRIP "${_expression}" _expression)
        string(REGEX MATCH "^(out_[A-Za-z_]+)" _lhs "${_expression}")
        set(_condition "${_lhs}.m() > 0")
        if(_expression MATCHES "^out_[A-Za-z_]+\\.block\\(([^,]+),")
            set(_condition "(${CMAKE_MATCH_1}) > 0")
        endif()
        string(REPLACE "${_expression};" "FRS_FATROP_KERNEL(Residual, ${_condition}, ${_expression});" _res "${_res}")
    endforeach()
    file(WRITE "${_source}/src/ocp/${_unit}.cpp" "#include \"fatrop_kernel_timer_v4.hpp\"\n${_res}")
endforeach()
foreach(_unit jacobian hessian)
    file(READ "${_source}/src/ocp/${_unit}.cpp" _res)
    if(_res MATCHES "fatrop_kernel_timer_v4.hpp")
        continue()
    endif()
    frs_calls(_res Residual two TRUE gemv_n gemv_t)
    frs_calls(_res Residual one TRUE axpy)
    string(REPLACE "out = alpha * y;" "FRS_FATROP_KERNEL(Residual, frs_fatrop_v4::in_residual() && alpha != 0.0 && alpha != 1.0, out = alpha * y);" _res "${_res}")
    file(WRITE "${_source}/src/ocp/${_unit}.cpp" "#include \"fatrop_kernel_timer_v4.hpp\"\n${_res}")
endforeach()
set(_linear "${_source}/include/fatrop/linear_algebra/linear_solver.hxx")
file(READ "${_linear}" _res)
if(NOT _res MATCHES "fatrop_kernel_timer_v4.hpp")
    frs_replace(_res "norm_inf(tmp_)" "FRS_FATROP_VALUE(Residual, norm_inf(tmp_))")
    frs_replace(_res "norm_inf(residual_)" "FRS_FATROP_VALUE(Residual, norm_inf(residual_))")
    frs_calls(_res Residual one FALSE axpy)
    file(WRITE "${_linear}" "#include \"fatrop_kernel_timer_v4.hpp\"\n${_res}")
endif()
message(STATUS "Private FATROP v4 numerical call-site instrumentation applied")
