cmake_minimum_required(VERSION 3.19)
# Source instrumentation only; this script does not build or run anything.
set(_here "${CMAKE_CURRENT_LIST_DIR}")
function(replace_once variable old new)
    set(value "${${variable}}")
    string(FIND "${value}" "${old}" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "Unsupported source; missing timer anchor: ${old}")
    endif()
    string(LENGTH "${old}" old_len)
    math(EXPR after "${found}+${old_len}")
    string(SUBSTRING "${value}" ${after} -1 tail)
    string(FIND "${tail}" "${old}" duplicate)
    if(NOT duplicate EQUAL -1)
        message(FATAL_ERROR "Ambiguous timer anchor: ${old}")
    endif()
    string(REPLACE "${old}" "${new}" value "${value}")
    set(${variable} "${value}" PARENT_SCOPE)
endfunction()
if(DEFINED ACADOS_SOURCE_DIR)
    set(_acados "${ACADOS_SOURCE_DIR}/acados/ocp_nlp/ocp_nlp_common.c")
    file(READ "${_acados}" _a)
    if(NOT _a MATCHES "acados_solve_timer.h")
        string(REGEX MATCHALL "(config->)?qp_solver->(evaluate|condense_rhs_and_solve)\\([^;]*\\)" _calls "${_a}")
        list(LENGTH _calls _n)
        if(_n LESS 1)
            message(FATAL_ERROR "No supported QP solve calls found")
        endif()
        set(_index 0)
        foreach(_call IN LISTS _calls)
            math(EXPR _index "${_index}+1")
            set(_call "${_call};")
            string(FIND "${_a}" "${_call}" _at)
            string(SUBSTRING "${_a}" 0 ${_at} _prefix)
            string(REGEX MATCH "[^\n]*$" _assignment "${_prefix}")
            string(STRIP "${_assignment}" _assignment_trim)
            if(NOT _assignment_trim MATCHES "^(int[ \t]+)?[A-Za-z_][A-Za-z_0-9]*[ \t]*=$")
                message(FATAL_ERROR "Unsupported QP assignment: ${_assignment_trim}")
            endif()
            set(_old "${_assignment}${_call}")
            replace_once(_a "${_old}"
                "    acados_timer frs_qp_timer_${_index};\n    if(frs_acados_enabled) acados_tic(&frs_qp_timer_${_index});\n${_old}\n    frs_acados_record(&frs_qp_timer_${_index});")
        endforeach()
        string(REGEX MATCHALL "config->qp_solver->eval_adj_sens\\([^;]*\\)" _calls "${_a}")
        list(LENGTH _calls _n)
        if(NOT _n EQUAL 1)
            message(FATAL_ERROR "Expected one adjoint solve call, found ${_n}")
        endif()
        list(GET _calls 0 _call)
        set(_call "${_call};")
        replace_once(_a "${_call}"
            "{ acados_timer frs_adjoint_timer;\n    if(frs_acados_enabled) acados_tic(&frs_adjoint_timer);\n    ${_call}\n    frs_acados_record(&frs_adjoint_timer); }")
        set(_a "#include \"acados_solve_timer.h\"\n${_a}")
    endif()
endif()
# Resolve every anchor before writing the dependency.
if(DEFINED ACADOS_SOURCE_DIR)
    configure_file("${_here}/acados_solve_timer.h" "${ACADOS_SOURCE_DIR}/acados/ocp_nlp/acados_solve_timer.h" COPYONLY)
    file(WRITE "${_acados}" "${_a}")
    message(STATUS "acados timers installed; rebuild/install that dependency.")
endif()
if(NOT DEFINED ACADOS_SOURCE_DIR)
    message(FATAL_ERROR "Specify ACADOS_SOURCE_DIR.")
endif()
