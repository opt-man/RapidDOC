diff --git a/src/Common/IpSolveKernelTimer.hpp b/src/Common/IpSolveKernelTimer.hpp
new file mode 100644
index 0000000..0db1e5c
--- /dev/null
+++ b/src/Common/IpSolveKernelTimer.hpp
@@ -0,0 +1,57 @@
+// Private instrumentation; it does not change Ipopt's numerical algorithm.
+#ifndef FRS_IPOPT_SOLVE_KERNEL_TIMER_HPP
+#define FRS_IPOPT_SOLVE_KERNEL_TIMER_HPP
+#include "IpoptConfig.h"
+#include <chrono>
+
+extern "C" {
+IPOPTLIB_EXPORT const char* frs_ipopt_solve_timer_protocol_v4();
+IPOPTLIB_EXPORT void frs_ipopt_solve_timer_reset_v4();
+IPOPTLIB_EXPORT double frs_ipopt_solve_timer_read_v4();
+IPOPTLIB_EXPORT double frs_ipopt_solve_timer_seconds_v4(int kind);
+IPOPTLIB_EXPORT unsigned long long frs_ipopt_solve_timer_count_v4(int kind);
+IPOPTLIB_EXPORT void frs_ipopt_solve_timer_add_v4(int kind, double seconds);
+IPOPTLIB_EXPORT int frs_ipopt_solve_timer_context_v4();
+IPOPTLIB_EXPORT int frs_ipopt_solve_timer_exchange_context_v4(int kind);
+IPOPTLIB_EXPORT bool frs_ipopt_solve_timer_enter_v4();
+IPOPTLIB_EXPORT void frs_ipopt_solve_timer_leave_v4();
+}
+
+namespace Ipopt {
+enum FrsKernelKind { FrsFactor = 0, FrsBacksolve = 1, FrsResidual = 2, FrsReduction = 3 };
+class FrsKernelScope {
+    int kind_;
+    bool outermost_;
+    std::chrono::steady_clock::time_point start_;
+public:
+    explicit FrsKernelScope(int kind) : kind_(kind),
+        outermost_(kind >= 0 && frs_ipopt_solve_timer_enter_v4()) {
+        if (outermost_) start_ = std::chrono::steady_clock::now();
+    }
+    ~FrsKernelScope() {
+        if (outermost_) {
+            const auto end = std::chrono::steady_clock::now();
+            frs_ipopt_solve_timer_add_v4(kind_, std::chrono::duration<double>(end-start_).count());
+        }
+        if (kind_ >= 0) frs_ipopt_solve_timer_leave_v4();
+    }
+};
+// A context is not timed. Only explicitly marked arithmetic inside it is.
+// This keeps cache lookup/update and temporary-vector allocation excluded.
+class FrsKernelContext {
+    int previous_;
+public:
+    explicit FrsKernelContext(int kind)
+        : previous_(frs_ipopt_solve_timer_exchange_context_v4(kind)) {}
+    ~FrsKernelContext() { frs_ipopt_solve_timer_exchange_context_v4(previous_); }
+};
+}
+
+// Wrap only numerical calls, never workspace creation, copies or assembly.
+#define FRS_IPOPT_KERNEL(kind, expr) \
+    ([&]() { Ipopt::FrsKernelScope frs_scope(kind); return (expr); }())
+#define FRS_IPOPT_CONTEXT(kind, expr) \
+    ([&]() { Ipopt::FrsKernelContext frs_context(kind); return (expr); }())
+#define FRS_IPOPT_CONTEXT_KERNEL(expr) \
+    FRS_IPOPT_KERNEL(frs_ipopt_solve_timer_context_v4(), expr)
+#endif
